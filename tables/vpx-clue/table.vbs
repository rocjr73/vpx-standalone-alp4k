		PuPlayer.LabelSet pBackglass,"RulesText","Collect a Weapon",1,"{'mt':2,'size':6, 'ypos':6}"
    Else ' normal ball lock
        BallsInLock(CurrentPLayer) = BallsInLock(CurrentPLayer) + 1
