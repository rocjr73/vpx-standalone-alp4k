            delay = 13000
			AddScore 100000
        Case 3
            Mode(CurrentPlayer, 3) = 1
            'pMsg2Lines "You Killed", "the Motorist", 4, "", 1
            'show a video and set the delay
            PuPlayer.playlistplayex pBackglass, "Kill", "KillMotorist.mp4", 100, 3
            delay = 14000
			AddScore 100000
        Case 4
            Mode(CurrentPlayer, 4) = 1
            'pMsg2Lines "You Killed", "the Maid", 4, "", 1
            'show a video and set the delay
            PuPlayer.playlistplayex pBackglass, "Kill", "KillMaid.mp4", 100, 3
            delay = 9000
			AddScore 100000
        Case 5
            Mode(CurrentPlayer, 5) = 1
            'pMsg2Lines "You Killed", "the Cop", 4, "", 1
            'show a video and set the delay
            PuPlayer.playlistplayex pBackglass, "Kill", "KillCop.mp4", 100, 3
            delay = 10000
			AddScore 100000
        Case 6
            Mode(CurrentPlayer, 6) = 1
            'pMsg2Lines "You Killed", "the Singing Telegram", 4, "", 1
