Sub CabinetKicker_Hit
    Dim delay
	Dim tmp
    delay = 2000
    ' PlaySound "Kicker_Hole"
	SoundSaucerLock
    'PlaySoundAtVol "Kicker_Hole", CabinetKicker, VolKick
    BallsInHole = BallsInHole + 1
    CabinetKicker.DestroyBall
    'PauseSong
    If Tilted Then vpmtimer.addTimer 200, "ModeHoleKick '":Exit Sub
    If l36.state = 2 then
        PhotoCount(CurrentPlayer) = PhotoCount(CurrentPlayer) + 1
        pMsg PhotoCount(CurrentPlayer) & " Photos Collected", 2, "", 0
        Addscore 2500
        CheckCollectables
    End If
    If l35.State = 2 Then
        AwardJackpot
        l35.State = 0:CheckSearchSuperJackpot:CheckMurderMultiball
    End If
    If l34.State = 2 Then 'give the superjackpot and start the normal jackpot lights
        AwardSuperJackpot
        l34.State = 0
        CounterTimer.Enabled = 0 'stop the counter at the dmd
        StartSearchLights
    End If
    If l37.State = 2 Then ' collect weapon
        AddScore 60000
        l37.State = 0
        l29.State = 2 'motive light
        Select Case Mode(CurrentPlayer, 0)
            'show a video and set the delay according to the duration of the video.
            Case 1:delay = 9000:PuPlayer.playlistplayex pBackglass, "Weapons", "Candlestick.mp4", 100, 9
            Case 2:delay = 9000:PuPlayer.playlistplayex pBackglass, "Weapons", "Knife.mp4", 100, 9
            Case 3:delay = 9000:PuPlayer.playlistplayex pBackglass, "Weapons", "Wrench.mp4", 100, 9
            Case 4:delay = 9000:PuPlayer.playlistplayex pBackglass, "Weapons", "Rope.mp4", 100, 9
            Case 5:delay = 9000:PuPlayer.playlistplayex pBackglass, "Weapons", "Pipe.mp4", 100, 9
            Case 6:delay = 9000:PuPlayer.playlistplayex pBackglass, "Weapons", "Revolver.mp4", 100, 9
            Case 7:delay = 9000:PuPlayer.playlistplayex pBackglass, "Weapons", "Revolver.mp4", 100, 9
        End Select
		PuPlayer.LabelSet pBackglass,"RulesTitle","Shoot Right Ramp",1,""
		PuPlayer.LabelSet pBackglass,"RulesText","Find the Motive",1,"{'mt':2,'size':6, 'ypos':6}"
    End If
    If l51.State = 2 Then 'feed The Dogs light
        tmp = 100000 + formatnumber(Jackpot(CurrentPlayer),0)
        pMsg2Lines "You fed the Dogs",  "" & formatnumber((tmp),0), 3, "", 1
        l51.State = 0
        CounterTimer.Enabled = 0 'stop the count at the dmd
        ' now maybe change the delay and show a video at this point
        delay = 4000
    End If
    vpmtimer.addTimer delay, "ModeHoleKick '"
    'vpmtimer.addTimer delay - 1000, "ResumeSong '"
End Sub

