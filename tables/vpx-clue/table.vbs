    If l23.State = 2 Then 'first key is collected "K"
        PuPlayer.playlistplayex pBackglass, "Key", "1Key.mp4", 100, 3
        AddScore 15000
		DOF 131, DOFPulse
        FlashForms FlasherLRYellow, 600, 50, 0
        FlashForms LRYellowUp, 600, 50, 0
        l23.State = 1
        l24.State = 2 'enable next key
    End If
End Sub

