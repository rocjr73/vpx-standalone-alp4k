Sub CountBonus_Timer
Dim tmp
    Select Case x
		Case 0:tmp= GSecretsCount(CurrentPlayer) * 5000: pMsg2Lines GSecretsCount(CurrentPlayer) & " Secrets Stolen ", FormatNumber(tmp,0), 2, "", 0:Playsound "fx_Next"
		Case 1:tmp= BribesCount(CurrentPlayer) * 5000: pMsg2Lines BribesCount(CurrentPlayer) & " Bribes Accepted ", FormatNumber(tmp,0), 2, "", 0:Playsound "fx_Next"
		Case 2:tmp= PhotoCount(CurrentPlayer) * 5000: pMsg2Lines PhotoCount(CurrentPlayer) & " Photos Found ", FormatNumber(tmp,0), 2, "", 0:Playsound "fx_Next"
		Case 3:tmp= CluesCount(CurrentPlayer) * 500: pMsg2Lines CluesCount(CurrentPlayer) & " Clues Collected ", FormatNumber(tmp,0), 2, "", 0:Playsound "fx_Next"
        Case 4:pMsg2Lines "Total Bonus X " & BonusMultiplier(CurrentPlayer), formatnumber(TotalBonus, 0), 3, "", 0:Playsound "fx_Next"
        Case 5:AddScore TotalBonus
		Case 6:pMsg2Lines "", " ", 2, "", 0  ' Clear messages
